---
import { portfolioData } from '../data/portfolioData';

const { socials } = portfolioData.personal;
---

<section id="contact" class="px-3.5 py-6 sm:px-6 sm:py-8">
  <!-- Section Header (Clean, Big & Bold) -->
  <div class="mb-5 sm:mb-6 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 border-b border-[var(--edge)] pb-2.5 sm:pb-3">
    <h2 class="text-xl sm:text-3xl font-bold tracking-tight text-[var(--foreground)]">
      Connect & Collaborate
    </h2>
    <span class="font-mono text-xs text-[var(--muted-foreground)]">Direct Channels & Links</span>
  </div>

  <p class="text-xs sm:text-sm text-[var(--muted-foreground)] leading-relaxed mb-3.5 sm:mb-4">
    Open to software engineering opportunities, full-stack projects, and discussions around data engineering architectures. Reach out through any of the channels below:
  </p>

  <!-- 2-Column Grid (Abdul Rehman Style) -->
  <div class="grid grid-cols-1 gap-2.5 sm:gap-3 sm:grid-cols-2">
    {socials.map((item) => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between rounded-xl border border-[var(--border)] bg-[var(--card)] p-3 sm:p-3.5 transition-all duration-200 hover:-translate-y-0.5 hover:border-[var(--muted-foreground)]/50 active:scale-[0.99]"
      >
        <div class="flex items-center gap-2.5 sm:gap-3">
          <div class="flex h-8.5 w-8.5 sm:h-9 sm:w-9 shrink-0 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--badge-bg)] text-[var(--foreground)] transition-transform group-hover:scale-105">
            {item.icon === 'github' && (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            )}
            {item.icon === 'linkedin' && (
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            )}
            {item.icon === 'mail' && (
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            )}
            {item.icon === 'message-square' && (
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            )}
          </div>

          <div>
            <h3 class="text-xs font-semibold text-[var(--foreground)] group-hover:text-emerald-500 transition-colors">
              {item.name}
            </h3>
            <p class="font-mono text-[10.5px] sm:text-[11px] text-[var(--muted-foreground)]">
              {item.username}
            </p>
          </div>
        </div>

        <svg class="h-3.5 w-3.5 text-[var(--muted-foreground)] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-[var(--foreground)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 7h10v10"></path>
          <path d="M7 17 17 7"></path>
        </svg>
      </a>
    ))}
  </div>
</section>
