---
import { portfolioData } from '../data/portfolioData';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[var(--edge)] bg-[var(--background)] px-3.5 py-6 sm:px-6 sm:py-8">
  <div class="flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
    <!-- Credits & Identity -->
    <div class="space-y-1 font-mono text-xs text-[var(--muted-foreground)]">
      <p class="text-[var(--foreground)] font-medium">
        © {currentYear} {portfolioData.personal.name}. All rights reserved.
      </p>
      <p class="text-[11px] text-[var(--muted-foreground)]/80">
        Engineered with Astro & Tailwind CSS v4 • 0 ms TBT Static Output
      </p>
    </div>

    <!-- Back to top button -->
    <button
      id="scroll-to-top"
      type="button"
      aria-label="Scroll to top"
      class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border)] bg-[var(--badge-bg)] px-3 py-1.5 font-mono text-xs font-medium text-[var(--foreground)] transition-transform hover:-translate-y-0.5 active:scale-95 cursor-pointer"
    >
      <span>Back to top</span>
      <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </button>
  </div>
</footer>

<script is:inline>
  const topBtn = document.getElementById('scroll-to-top');
  if (topBtn) {
    topBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
