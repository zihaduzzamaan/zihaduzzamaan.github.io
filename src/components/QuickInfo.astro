---
// QuickInfo / Bio Data Section
// Professional single-column info list: optimized for clarity and professionalism
import { portfolioData } from '../data/portfolioData';

const { personal } = portfolioData;
---

<div class="px-3.5 py-4 sm:px-6 sm:py-5">
  <!-- Single-Column Information List -->
  <div class="space-y-2.5 sm:space-y-3 max-w-2xl">
    <!-- 1. PRIMARY: Web & App Developer (Higher Opacity, Stands Out) -->
    <div class="flex items-center gap-2.5 sm:gap-3 group">
      <div class="flex size-6.5 sm:size-7 shrink-0 items-center justify-center rounded-lg border border-emerald-400/40 dark:border-emerald-500/25 bg-emerald-50/80 dark:bg-emerald-950/30 ring-1 ring-emerald-500/10 dark:ring-emerald-400/10 ring-offset-1 ring-offset-[var(--background)] shadow-2xs text-emerald-600 dark:text-emerald-400 transition-colors group-hover:border-emerald-500/60 dark:group-hover:border-emerald-400/40">
        <svg class="size-3 sm:size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </div>
      <div class="font-mono text-[11px] sm:text-[13px] text-[var(--foreground)] font-semibold min-w-0 leading-snug break-words sm:truncate flex-1">
        Web & App Developer • Full-Stack Engineer
      </div>
    </div>

    <!-- 2. Education Track -->
    <div class="flex items-center gap-2.5 sm:gap-3 group">
      <div class="flex size-6.5 sm:size-7 shrink-0 items-center justify-center rounded-lg border border-zinc-300/60 dark:border-white/10 bg-zinc-100/70 dark:bg-[#151517] ring-1 ring-black/5 dark:ring-white/5 ring-offset-1 ring-offset-[var(--background)] shadow-2xs text-zinc-500 dark:text-zinc-400 transition-colors group-hover:border-zinc-400 dark:group-hover:border-white/20">
        <svg class="size-3 sm:size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
          <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
        </svg>
      </div>
      <div class="font-mono text-[11px] sm:text-[13px] text-[var(--muted-foreground)] font-medium min-w-0 leading-snug break-words sm:truncate flex-1">
        2nd Year • Software Engineering Undergraduate
      </div>
    </div>

    <!-- 3. Location -->
    <div class="flex items-center gap-2.5 sm:gap-3 group">
      <div class="flex size-6.5 sm:size-7 shrink-0 items-center justify-center rounded-lg border border-zinc-300/60 dark:border-white/10 bg-zinc-100/70 dark:bg-[#151517] ring-1 ring-black/5 dark:ring-white/5 ring-offset-1 ring-offset-[var(--background)] shadow-2xs text-zinc-500 dark:text-zinc-400 transition-colors group-hover:border-zinc-400 dark:group-hover:border-white/20">
        <svg class="size-3 sm:size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </div>
      <div class="font-mono text-[11px] sm:text-[13px] text-[var(--muted-foreground)] font-medium min-w-0 leading-snug break-words sm:truncate flex-1">
        Rangpur City, Bangladesh
      </div>
    </div>

    <!-- 4. Email Address -->
    <div class="flex items-center gap-2.5 sm:gap-3 group">
      <div class="flex size-6.5 sm:size-7 shrink-0 items-center justify-center rounded-lg border border-zinc-300/60 dark:border-white/10 bg-zinc-100/70 dark:bg-[#151517] ring-1 ring-black/5 dark:ring-white/5 ring-offset-1 ring-offset-[var(--background)] shadow-2xs text-zinc-500 dark:text-zinc-400 transition-colors group-hover:border-zinc-400 dark:group-hover:border-white/20">
        <svg class="size-3 sm:size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </div>
      <a
        href="mailto:zihaduzzamanzishan@gmail.com"
        class="font-mono text-[11px] sm:text-[13px] text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:underline font-medium min-w-0 leading-snug break-words sm:truncate flex-1 transition-colors"
      >
        zihaduzzamanzishan@gmail.com
      </a>
    </div>

    <!-- 5. Phone Contact -->
    <div class="flex items-center gap-2.5 sm:gap-3 group">
      <div class="flex size-6.5 sm:size-7 shrink-0 items-center justify-center rounded-lg border border-zinc-300/60 dark:border-white/10 bg-zinc-100/70 dark:bg-[#151517] ring-1 ring-black/5 dark:ring-white/5 ring-offset-1 ring-offset-[var(--background)] shadow-2xs text-zinc-500 dark:text-zinc-400 transition-colors group-hover:border-zinc-400 dark:group-hover:border-white/20">
        <svg class="size-3 sm:size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </div>
      <a
        href="https://wa.me/8801872624475"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[11px] sm:text-[13px] text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:underline font-medium min-w-0 leading-snug break-words sm:truncate flex-1 transition-colors"
      >
        +880 1872-624475 (Mobile & WhatsApp)
      </a>
    </div>

    <!-- 6. Portfolio Website (Temporarily Hidden) -->
  </div>
</div>
