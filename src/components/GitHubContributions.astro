---
// Authentic GitHub Contribution Graph
// Matched 1:1 with GitHub's exact font stack, native theme colors, layout and medium contribution level (451 commits).
// Zero unnecessary bloat: cleanly structured to match the official GitHub profile UI.

import contributionsData from '../data/githubContributionsData.json';

interface DayItem {
  date: string;
  count: number;
  level: number;
  formatted: string;
}

const totalCount = contributionsData.total || 451;
const rawContributions: DayItem[] = contributionsData.contributions;

// Group 366 days into 53 weeks (Sunday to Saturday)
const weeks: DayItem[][] = [];
for (let i = 0; i < rawContributions.length; i += 7) {
  weeks.push(rawContributions.slice(i, i + 7));
}

// 12 Month positions based on first occurrence of each month (matching GitHub exactly)
const monthsList = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const monthLabels: { col: number; label: string }[] = [];
let lastMonth = -1;

for (let i = 0; i < rawContributions.length; i += 7) {
  const item = rawContributions[i];
  const d = new Date(item.date);
  const m = d.getMonth();
  const w = Math.floor(i / 7);
  if (m !== lastMonth && w < 50) {
    monthLabels.push({ col: w, label: monthsList[m] });
    lastMonth = m;
  }
}
---

<section id="activity" class="py-10 px-4 max-w-5xl mx-auto" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';">
  <!-- Top bar: Total count & Contribution settings -->
  <div class="flex items-center justify-between mb-2 px-1">
    <h2 class="text-[16px] font-normal text-[#1f2328] dark:text-[#e6edf3]">
      <span id="github-total-count">{totalCount}</span> contributions in the last year
    </h2>

    <!-- Contribution settings dropdown -->
    <div class="relative">
      <button
        id="contrib-settings-btn"
        type="button"
        class="text-[12px] text-[#656d76] dark:text-[#7d8590] hover:text-[#1f2328] dark:hover:text-[#e6edf3] inline-flex items-center gap-1 cursor-pointer transition-colors"
      >
        <span>Contribution settings</span>
        <svg class="w-3 h-3 text-[#656d76] dark:text-[#7d8590]" viewBox="0 0 16 16" fill="currentColor">
          <path d="m4.427 7.427 3.396 3.396a.25.25 0 0 0 .354 0l3.396-3.396A.25.25 0 0 0 11.396 7H4.604a.25.25 0 0 0-.177.427Z"></path>
        </svg>
      </button>

      <!-- Dropdown -->
      <div
        id="contrib-settings-menu"
        class="hidden absolute right-0 mt-1.5 w-60 rounded-md bg-white dark:bg-[#161b22] border border-zinc-200 dark:border-[#30363d] shadow-lg z-50 p-1 text-[12px]"
      >
        <a
          href="https://github.com/zihaduzzamaan"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded text-[#1f2328] dark:text-[#e6edf3] hover:bg-zinc-100 dark:hover:bg-[#21262d] transition-colors"
        >
          <span>View on GitHub</span>
          <span class="text-[#656d76] dark:text-[#7d8590]">@zihaduzzamaan ↗</span>
        </a>
        <a
          href="https://docs.github.com/en/get-started/exploring-projects-on-github/viewing-contributions-on-your-profile"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded text-[#1f2328] dark:text-[#e6edf3] hover:bg-zinc-100 dark:hover:bg-[#21262d] transition-colors border-t border-zinc-100 dark:border-[#21262d]"
        >
          <span>Contribution guidelines</span>
          <span class="text-[#656d76] dark:text-[#7d8590]">Docs ↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main GitHub Card Container -->
  <div class="border border-zinc-200 dark:border-[#30363d] rounded-md bg-white dark:bg-[#0d1117] p-4 sm:p-5">
    
    <!-- Heatmap Scrollable Wrapper -->
    <div class="overflow-x-auto pb-1 scrollbar-none">
      <div class="min-w-[740px] select-none text-[12px]">
        
        <!-- Months Labels Row -->
        <div class="relative h-5 text-[#656d76] dark:text-[#7d8590] pl-8">
          {monthLabels.map((m) => (
            <span
              class="absolute top-0 text-[12px]"
              style={`left: ${32 + m.col * 13}px;`}
            >
              {m.label}
            </span>
          ))}
        </div>

        <!-- Heatmap Grid: Day labels + Week Columns -->
        <div class="flex gap-[3px]">
          <!-- Day Labels (Mon, Wed, Fri) -->
          <div class="flex flex-col gap-[3px] text-[12px] text-[#656d76] dark:text-[#7d8590] pr-2 w-8 shrink-0 text-left select-none">
            <span class="h-[10px]"></span>
            <span class="h-[10px] leading-[10px]">Mon</span>
            <span class="h-[10px]"></span>
            <span class="h-[10px] leading-[10px]">Wed</span>
            <span class="h-[10px]"></span>
            <span class="h-[10px] leading-[10px]">Fri</span>
            <span class="h-[10px]"></span>
          </div>

          <!-- 53 Week Columns -->
          {weeks.map((week) => (
            <div class="flex flex-col gap-[3px] shrink-0">
              {week.map((day) => {
                // Exact GitHub Dark & Light level color mapping
                const colorClasses = [
                  // Level 0
                  "bg-[#ebedf0] dark:bg-[#161b22] outline outline-1 outline-[#1b1f2426] dark:outline-[#ffffff0d] -outline-offset-1",
                  // Level 1
                  "bg-[#9be9a8] dark:bg-[#0e4429]",
                  // Level 2
                  "bg-[#40c463] dark:bg-[#006d32]",
                  // Level 3
                  "bg-[#30a14e] dark:bg-[#26a641]",
                  // Level 4
                  "bg-[#216e39] dark:bg-[#39d353]"
                ];

                return (
                  <div
                    class={`gh-cell w-[10px] h-[10px] rounded-[2px] cursor-pointer transition-transform hover:scale-125 hover:z-10 ${colorClasses[day.level]}`}
                    data-date={day.date}
                    data-count={day.count}
                    data-formatted={day.formatted}
                  />
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Footer Row: Learn how we count contributions | Less ... More -->
    <div class="mt-4 pt-3 flex items-center justify-between text-[12px] text-[#656d76] dark:text-[#7d8590]">
      <a
        href="https://docs.github.com/en/get-started/exploring-projects-on-github/viewing-contributions-on-your-profile"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[#0969da] dark:hover:text-[#4493f8] transition-colors"
      >
        Learn how we count contributions
      </a>

      <!-- Legend (Exact GitHub shades) -->
      <div class="flex items-center gap-1.5 select-none">
        <span>Less</span>
        <div class="flex items-center gap-[3px]">
          <span class="w-[10px] h-[10px] rounded-[2px] bg-[#ebedf0] dark:bg-[#161b22] outline outline-1 outline-[#1b1f2426] dark:outline-[#ffffff0d] -outline-offset-1"></span>
          <span class="w-[10px] h-[10px] rounded-[2px] bg-[#9be9a8] dark:bg-[#0e4429]"></span>
          <span class="w-[10px] h-[10px] rounded-[2px] bg-[#40c463] dark:bg-[#006d32]"></span>
          <span class="w-[10px] h-[10px] rounded-[2px] bg-[#30a14e] dark:bg-[#26a641]"></span>
          <span class="w-[10px] h-[10px] rounded-[2px] bg-[#216e39] dark:bg-[#39d353]"></span>
        </div>
        <span>More</span>
      </div>
    </div>
  </div>

  <!-- Native GitHub Floating Tooltip -->
  <div
    id="gh-tooltip"
    class="pointer-events-none fixed hidden z-50 px-2 py-1 rounded bg-[#24292f] dark:bg-[#24292f] text-white text-[11px] shadow-lg -translate-x-1/2 -translate-y-full mb-2 whitespace-nowrap"
    style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;"
  >
    <span id="gh-tooltip-text">0 contributions</span>
  </div>
</section>

<script is:inline>
  (function initGitHubContributions() {
    const tooltip = document.getElementById('gh-tooltip');
    const tooltipText = document.getElementById('gh-tooltip-text');
    const cells = document.querySelectorAll('.gh-cell');
    const settingsBtn = document.getElementById('contrib-settings-btn');
    const settingsMenu = document.getElementById('contrib-settings-menu');

    // Tooltip handling
    cells.forEach((cell) => {
      cell.addEventListener('mouseenter', () => {
        const count = cell.getAttribute('data-count') || '0';
        const formatted = cell.getAttribute('data-formatted') || '';
        
        if (tooltip && tooltipText) {
          if (count === '0') {
            tooltipText.textContent = `No contributions on ${formatted}.`;
          } else if (count === '1') {
            tooltipText.textContent = `1 contribution on ${formatted}.`;
          } else {
            tooltipText.textContent = `${count} contributions on ${formatted}.`;
          }

          tooltip.classList.remove('hidden');
          const rect = cell.getBoundingClientRect();
          tooltip.style.left = `${rect.left + rect.width / 2}px`;
          tooltip.style.top = `${rect.top - 6}px`;
        }
      });

      cell.addEventListener('mouseleave', () => {
        if (tooltip) tooltip.classList.add('hidden');
      });
    });

    // Dropdown toggle
    if (settingsBtn && settingsMenu) {
      settingsBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        settingsMenu.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!settingsMenu.contains(e.target) && e.target !== settingsBtn) {
          settingsMenu.classList.add('hidden');
        }
      });
    }

    // Client-side refresh if live API updates
    fetch('https://github-contributions-api.jogruber.de/v4/zihaduzzamaan?y=last')
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (data && data.total && typeof data.total.lastYear === 'number') {
          const totalEl = document.getElementById('github-total-count');
          if (totalEl) totalEl.textContent = data.total.lastYear;
        }
      })
      .catch(() => {});
  })();
</script>
