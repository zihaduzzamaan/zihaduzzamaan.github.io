---
// Aarav Sharma's Tactile Action Pills
// Visually differentiated "Available for Work" badge + 3 compact circular tactile buttons (GitHub, WhatsApp, LinkedIn)
---

<div class="flex flex-row sm:flex-col items-center justify-between sm:justify-center w-full sm:w-auto gap-2.5 sm:gap-2">
  <!-- Visually Differentiated "Available for Work" Pill with Elegant Perimeter Shimmer (No Blinking Dot) -->
  <a
    href="mailto:zihaduzzamanzishan@gmail.com?subject=Work%20Inquiry%20-%20MD%20Zihaduzzaman"
    target="_blank"
    rel="noopener noreferrer"
    class="group relative inline-flex overflow-hidden rounded-full p-[1px] focus:outline-none transition-all duration-200 ease-out hover:scale-105 active:scale-95 select-none shrink-0"
    style="background: rgba(16, 185, 129, 0.22);"
    title="Currently Available for Software Engineering & Full-Stack Projects"
  >
    <!-- Minimal & Elegant Rotating Shimmer Beam Around the Border -->
    <span
      class="shimmer-beam absolute inset-[-1000%]"
      style="
        background: conic-gradient(from 90deg at 50% 50%, transparent 0%, rgba(16, 185, 129, 0.1) 25%, #34d399 50%, rgba(16, 185, 129, 0.1) 75%, transparent 100%);
      "
    ></span>

    <!-- Tactile Inner Pill Container -->
    <span
      class="relative inline-flex h-7 items-center justify-center rounded-full px-2.5 sm:px-3 text-[10.5px] sm:text-[11px] font-semibold text-emerald-300 backdrop-blur-xl transition-colors group-hover:text-emerald-100"
      style="
        background: linear-gradient(135deg, rgba(6, 78, 59, 0.6) 0%, rgba(16, 24, 20, 0.95) 100%);
        box-shadow: inset 0 1px 1px 0 rgba(255, 255, 255, 0.15), 0 2px 8px -1px rgba(16, 185, 129, 0.25);
      "
    >
      <span class="tracking-tight font-medium">Available for Work</span>
    </span>
  </a>

  <!-- Tactile Pill Buttons Row (Side-by-Side with Available for Work on Mobile) -->
  <div class="flex items-center justify-center gap-1.5 sm:gap-2 shrink-0">
    <!-- 1. GitHub -->
    <a
      href="https://github.com/zihaduzzamaan"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub Profile"
      title="GitHub"
      class="group relative flex h-7 w-7 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-700 shadow-2xs hover:border-zinc-400 hover:bg-zinc-100 hover:text-zinc-950 dark:border-white/14 dark:bg-[#1c1c1f] dark:text-zinc-300 dark:hover:border-white/30 dark:hover:bg-[#2c2c30] dark:hover:text-white transition-all duration-150 ease-out hover:scale-110 active:scale-95 cursor-pointer"
      style="
        box-shadow: var(--pill-shadow, 0 1px 2px rgba(0, 0, 0, 0.05));
      "
    >
      <svg class="h-3.5 w-3.5 fill-current transition-transform duration-150 group-hover:scale-110" viewBox="0 0 24 24">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
    </a>

    <!-- 2. WhatsApp (Direct Chat for 01743600296) -->
    <a
      href="https://wa.me/8801743600296"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
      title="WhatsApp (+880 1743-600296)"
      class="group relative flex h-7 w-7 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-700 shadow-2xs hover:border-emerald-400 hover:bg-emerald-50 hover:text-emerald-600 dark:border-white/14 dark:bg-[#1c1c1f] dark:text-zinc-300 dark:hover:border-emerald-500/50 dark:hover:bg-emerald-950/40 dark:hover:text-[#25D366] transition-all duration-150 ease-out hover:scale-110 active:scale-95 cursor-pointer"
      style="
        box-shadow: var(--pill-shadow, 0 1px 2px rgba(0, 0, 0, 0.05));
      "
    >
      <svg class="h-3.5 w-3.5 fill-current transition-transform duration-150 group-hover:scale-110" viewBox="0 0 24 24">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24M8.53 7.33c-.2-.43-.4-.44-.59-.45h-.5c-.18 0-.47.07-.71.33-.25.26-.95.93-.95 2.27s.98 2.64 1.11 2.82c.14.18 1.9 3.04 4.69 4.15 2.32.92 2.79.74 3.29.69.5-.05 1.61-.66 1.84-1.3.23-.64.23-1.18.16-1.3-.07-.11-.25-.18-.53-.32s-1.61-.8-1.86-.89c-.25-.09-.43-.14-.61.14-.18.27-.71.89-.87 1.07-.16.18-.32.2-.6.07-.27-.14-1.15-.42-2.19-1.35-.81-.72-1.36-1.61-1.52-1.88-.16-.27-.02-.42.12-.55.12-.12.27-.32.41-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48s-.59-1.46-.83-1.99z"/>
      </svg>
    </a>

    <!-- 3. LinkedIn ('in' icon) -->
    <a
      href="https://linkedin.com/in/mdzihaduzzaman"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn Profile"
      title="LinkedIn"
      class="group relative flex h-7 w-7 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-700 shadow-2xs hover:border-blue-400 hover:bg-blue-50 hover:text-[#0a66c2] dark:border-white/14 dark:bg-[#1c1c1f] dark:text-zinc-300 dark:hover:border-blue-500/50 dark:hover:bg-blue-950/40 dark:hover:text-[#38bdf8] transition-all duration-150 ease-out hover:scale-110 active:scale-95 cursor-pointer"
      style="
        box-shadow: var(--pill-shadow, 0 1px 2px rgba(0, 0, 0, 0.05));
      "
    >
      <svg class="h-3 w-3 fill-current transition-transform duration-150 group-hover:scale-110" viewBox="0 0 24 24">
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
      </svg>
    </a>
  </div>
</div>

<style>
  .shimmer-beam {
    animation: spin-beam 3.5s linear infinite;
    will-change: transform;
  }

  @keyframes spin-beam {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shimmer-beam {
      animation: none;
    }
  }
</style>
