---
// Abdul Rehman Waseem's Signature Interactive Physics Pull Cord Theme Switcher
// Extracted and replicated directly from https://github.com/abdulrehmanwaseem/My-Portfolio
---

<!-- Import Google Font Caveat for the authentic hand-drawn hint -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet">

<style>
  :root {
    --pullcord-top: 0px;
    --pullcord-right: max(0.75rem, calc((100vw - 64rem) / 2 - 130px));
    --pullcord-z: 30;
    --pullcord-ink: rgba(161, 161, 170, 0.65);
  }

  :global(.dark) {
    --pullcord-ink: rgba(113, 113, 122, 0.65);
  }

  .pullcord {
    position: fixed;
    top: var(--pullcord-top);
    right: var(--pullcord-right);
    z-index: var(--pullcord-z);
    width: 64px;
    height: 340px;
    pointer-events: none;
  }

  .pullcord-inner {
    position: absolute;
    inset: 0;
  }

  /* One-time gravity drop entrance from ceiling with natural acceleration */
  .pullcord-inner--drop {
    animation: pullcord-drop 0.6s 0.4s cubic-bezier(0.45, 0, 0.9, 0.5) both;
  }

  @keyframes pullcord-drop {
    0% {
      opacity: 0;
      transform: translateY(-230px);
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pullcord-inner--drop {
      animation: none;
    }
  }

  .pullcord-knob {
    -webkit-tap-highlight-color: transparent;
    border-radius: 50%;
    cursor: grab;
    touch-action: none;
    pointer-events: auto;
    border: none;
    background: transparent;
    padding: 0;
  }

  .pullcord-knob:active {
    cursor: grabbing;
  }

  .pullcord-knob:focus-visible {
    outline: 2px solid var(--pullcord-ink);
    outline-offset: -9px;
  }

  /* Hide pullcord below sm screen (40rem / 640px) like Abdul's site */
  @media (width < 40rem) {
    .pullcord {
      display: none !important;
    }
  }

  /* ── PullCord Hint (Fixed Size, Rigidly Pinned Beside Resting Knob) ───
     Instruction component with fixed dimensions pointing directly at the white sphere knob */
  .cord-hint {
    position: fixed;
    top: calc(var(--pullcord-top, 0px) + 144px);
    right: calc(var(--pullcord-right, 1rem) + 44px);
    width: 140px;
    height: 52px;
    display: flex !important;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    white-space: nowrap;
    pointer-events: none;
    z-index: 50;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .cord-hint-text {
    font-family: 'Caveat', cursive, "Segoe Script", "Bradley Hand";
    font-size: 22px;
    font-weight: 700;
    line-height: 0.95;
    text-align: right;
    user-select: none;
    color: #3f3f46;
    transform: rotate(-4deg);
    display: inline-block;
  }

  :global(.dark) .cord-hint-text {
    color: #e4e4e7;
  }

  .cord-hint-arrow {
    flex: none;
    width: 44px;
    height: 50px;
    transform: rotate(14deg);
    transform-origin: center;
    color: #71717a;
  }

  :global(.dark) .cord-hint-arrow {
    color: #a1a1aa;
  }

  @media (width < 40rem) {
    .pullcord,
    .cord-hint {
      display: none !important;
    }
  }
</style>

<div id="pullcord-host" class="pullcord" aria-hidden="false">
  <div id="pullcord-inner" class="pullcord-inner pullcord-inner--drop">
    <!-- Rope SVG Canvas -->
    <svg
      id="cord-svg"
      viewBox="0 0 64 340"
      width="64"
      height="340"
      aria-hidden="true"
      style="overflow: visible;"
    >
      <defs>
        <!-- Knob Spherical Radial / Linear Gradient -->
        <linearGradient id="pc-knob" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff"></stop>
          <stop offset="100%" stop-color="#e7e7ec"></stop>
        </linearGradient>

        <!-- Knob Shadow -->
        <filter id="pc-knob-sh" x="-70%" y="-70%" width="240%" height="240%">
          <feDropShadow dx="0" dy="1.4" stdDeviation="1.5" flood-color="rgba(0,0,0,0.32)"></feDropShadow>
        </filter>
      </defs>

      <!-- Smooth Quadratic Midpoint Bezier Dynamic Rope -->
      <path
        id="cord-path"
        d="M 32.0 0.0 L 32.0 176.0"
        stroke="var(--pullcord-ink)"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
        vector-effect="non-scaling-stroke"
      ></path>

      <!-- Knob Node Group with Transform Matrix -->
      <g id="cord-group">
        <g filter="url(#pc-knob-sh)">
          <circle
            cx="32"
            cy="176"
            r="6.5"
            fill="url(#pc-knob)"
            stroke="rgba(0,0,0,0.10)"
            stroke-width="0.5"
          ></circle>
        </g>
      </g>
    </svg>

    <!-- Invisible Ergonomic Touch/Click Target (46px diameter) -->
    <button
      id="cord-btn"
      type="button"
      class="pullcord-knob"
      aria-label="Toggle theme"
      title="Pull cord to toggle theme"
      style="position: absolute; left: 9px; top: 153px; width: 46px; height: 46px;"
    ></button>
  </div>

  <!-- Fixed-Size Instruction Component ("pull the cord!") -->
  <div id="cord-hint" class="cord-hint" aria-hidden="true">
    <span class="cord-hint-text">
      pull the<br />cord!
    </span>
    <svg
      class="cord-hint-arrow"
      viewBox="16 11 59 68"
      width="44"
      height="50"
      aria-hidden="true"
    >
      <path
        d="M63.9304352,16.6935883c-0.7543335-0.2961426-1.5021973-0.5897217-2.2429199-0.8804922c-0.4156494-0.151001-0.8272705-0.3005371-1.2348022-0.4485474c-0.8189087-0.2849731-1.6208496-0.5641479-2.4039307-0.8366699c-3.142334-1.060791-6.0206909-1.8996582-8.4889526-2.4821777c-4.9364014-1.164978-8.2321777-1.3042603-8.7171021-0.1418457c-0.4849243,1.1624756,1.9327393,3.4066162,6.2335815,6.0951529c1.8245239,1.140564,4.0041504,2.3630371,6.4287109,3.6149292c-3.9299927,0.5129395-8.5645752,1.7341919-13.3596802,4.0892334c-2.4478149,1.2183838-4.8989258,2.7646484-7.2866211,4.5922241c-2.3288574,1.8961792-4.618042,4.0429077-6.6160278,6.5328979c-4.0496826,4.9500122-6.6275635,10.5092773-8.1968384,15.6245728c-1.5393066,5.1433716-2.2120972,9.887085-2.272583,13.8354492c-0.1154785,1.9729614,0.012085,3.7541504,0.1219482,5.3097534c0.0647583,0.777832,0.1106567,1.4995117,0.2159424,2.1618042c0.1115112,0.6623535,0.2285767,1.265686,0.350769,1.8070068c0.4889526,2.1658325,1.0587769,3.3349609,1.6884766,3.3342896c0.6296387-0.0006104,1.2607422-1.1640625,1.8604736-3.2163696c0.1498413-0.5132446,0.2977295-1.0822754,0.4429321-1.703186c0.1628418-0.6179199,0.3389282-1.2863159,0.5276489-2.0026855c0.3671875-1.4299927,0.6803589-3.0605469,1.182373-4.8129272c0.8353271-3.5391235,2.0805664-7.6299438,3.805542-11.9075317c1.7584839-4.2592163,4.09375-8.6965942,7.3496704-12.6729736c1.6064453-2.0076294,3.4013062-3.7537842,5.2017822-5.3754272c1.8607788-1.5527344,3.755249-2.9500122,5.6772461-4.1428223c3.8567505-2.3618164,7.7036743-4.0240479,11.0596924-5.2119751c0.1141968-0.0405884,0.2226563-0.0770874,0.3356323-0.1167603c-2.00354,2.4140625-3.7368164,4.677124-5.1082764,6.6715088c-2.8739014,4.1792603-4.1975708,7.2007446-3.2896729,8.0737915c0.9078369,0.8730469,3.8753052-0.5675049,7.9391479-3.602478c2.0318604-1.5174561,4.3378906-3.4335327,6.7976074-5.6582031c0.6096802-0.5618896,1.2340698-1.1373901,1.8716431-1.7250366c0.3148193-0.2980347,0.6328735-0.5991821,0.9540405-0.9032593c0.5633545-0.5615845,1.1321411-1.128479,1.7058105-1.7003784c2.5238647-2.5367432,5.1615601-5.2334595,7.8085938-7.9859619C70.7511749,19.4375458,67.2552032,18.0151825,63.9304352,16.6935883z"
        fill="currentColor"
      ></path>
    </svg>
  </div>
</div>

<script is:inline>
  (function initAbdulPullCord() {
    // ── Exact Constants from pullcord package ─────────────────────────────
    const CONFIG = {
      gravity: 1250,
      damping: 0.94,
      iterations: 20,
      stretchMax: 26,
      stretchToggle: 20,
      maxVelocity: 22,
      sleepVelocity: 0.15
    };

    const W = 64;
    const ANCHOR_X = W / 2; // 32
    const REST_Y = 176;
    const SEGMENTS = 16;
    const REST_SEG = REST_Y / SEGMENTS; // 11

    const cordPath = document.getElementById('cord-path');
    const cordGroup = document.getElementById('cord-group');
    const cordBtn = document.getElementById('cord-btn');
    const innerEl = document.getElementById('pullcord-inner');
    const hintEl = document.getElementById('cord-hint');

    if (!cordPath || !cordGroup || !cordBtn || !innerEl) return;

    // Build initial 16 nodes
    const pts = [];
    for (let i = 0; i <= SEGMENTS; i++) {
      const y = REST_SEG * i;
      pts.push({ x: ANCHOR_X, y, ox: ANCHOR_X, oy: y, fixed: i === 0 });
    }
    const last = pts.length - 1;

    // Midpoint quadratic bezier spline string builder
    function buildPath(p) {
      let d = `M ${p[0].x.toFixed(1)} ${p[0].y.toFixed(1)}`;
      for (let i = 1; i < p.length - 1; i++) {
        const xc = (p[i].x + p[i + 1].x) / 2;
        const yc = (p[i].y + p[i + 1].y) / 2;
        d += ` Q ${p[i].x.toFixed(1)} ${p[i].y.toFixed(1)} ${xc.toFixed(1)} ${yc.toFixed(1)}`;
      }
      d += ` L ${p[p.length - 1].x.toFixed(1)} ${p[p.length - 1].y.toFixed(1)}`;
      return d;
    }

    // Audio click sound (Abdul Rehman's exact sound)
    let clickAudio = null;
    try {
      clickAudio = new Audio('/audio/ui-sounds/click.wav');
      clickAudio.preload = 'auto';
    } catch (_) {}

    function playClick() {
      if (clickAudio) {
        try {
          clickAudio.currentTime = 0;
          clickAudio.play().catch(() => {});
        } catch (_) {}
      }
    }

    // Simulation state
    let raf = 0;
    let running = false;
    let prevT = 0;
    let prevDt = 0;
    let dragging = false;
    let didDrag = false;
    let clicked = false;
    let target = { x: ANCHOR_X, y: REST_Y };

    function render() {
      cordPath.setAttribute('d', buildPath(pts));
      const tx = (pts[last].x - ANCHOR_X).toFixed(2);
      const ty = (pts[last].y - REST_Y).toFixed(2);
      cordGroup.setAttribute('transform', `translate(${tx} ${ty})`);
      cordBtn.style.transform = `translate(${tx}px, ${ty}px)`;
    }

    // Exact Verlet Integration step
    function step(now) {
      const { gravity, damping, iterations, sleepVelocity } = CONFIG;
      const dt = prevT ? Math.min(0.04, Math.max(4e-3, (now - prevT) / 1e3)) : 1 / 60;
      prevT = now;
      const tc = prevDt > 0 ? dt / prevDt : 1;
      const velCoef = tc * Math.pow(damping, dt * 60);
      const accCoef = dt * dt;

      pts[last].fixed = dragging;

      // Verlet positions update
      for (let i = 1; i < pts.length; i++) {
        const p = pts[i];
        if (p.fixed) continue;
        const vx = p.x - p.ox;
        const vy = p.y - p.oy;
        p.ox = p.x;
        p.oy = p.y;
        p.x += vx * velCoef;
        p.y += vy * velCoef + gravity * accCoef;
      }

      // Anchor top fixed
      pts[0].x = ANCHOR_X;
      pts[0].y = 0;

      // When dragging, pin last node to target
      if (dragging) {
        pts[last].ox = pts[last].x;
        pts[last].oy = pts[last].y;
        pts[last].x = target.x;
        pts[last].y = target.y;
      }

      // 20 relaxation passes for cloth/rope distance constraints
      for (let k = 0; k < iterations; k++) {
        for (let i = 0; i < last; i++) {
          const a = pts[i];
          const b = pts[i + 1];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.hypot(dx, dy) || 1e-4;
          const diff = (REST_SEG - dist) / dist * 0.5;
          const ox = dx * diff;
          const oy = dy * diff;
          if (!a.fixed) {
            a.x -= ox;
            a.y -= oy;
          }
          if (!b.fixed) {
            b.x += ox;
            b.y += oy;
          }
        }
      }

      prevDt = dt;
      render();

      // Kinetic energy check for sleeping
      let speed = 0;
      for (let i = 1; i < pts.length; i++) {
        speed += Math.abs(pts[i].x - pts[i].ox) + Math.abs(pts[i].y - pts[i].oy);
      }

      if (!dragging && speed < sleepVelocity * dt * 60) {
        render();
        running = false;
        return;
      }

      raf = requestAnimationFrame(step);
    }

    function wake() {
      if (running) return;
      running = true;
      prevT = 0;
      prevDt = 0;
      raf = requestAnimationFrame(step);
    }

    // Toggle Theme & sync UI
    function toggleTheme() {
      playClick();
      if (navigator.vibrate) navigator.vibrate(20);

      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');

      // Sync header toggle buttons if present
      const moon = document.getElementById('theme-moon');
      const sun = document.getElementById('theme-sun');
      if (moon && sun) {
        if (isDark) {
          moon.classList.add('hidden');
          sun.classList.remove('hidden');
        } else {
          sun.classList.add('hidden');
          moon.classList.remove('hidden');
        }
      }
    }

    // Hint management: Ensure instruction component is always visible and clear any old dismissal lock
    try {
      localStorage.removeItem('cord-hint-dismissed');
    } catch (_) {}
    if (hintEl) {
      hintEl.style.display = 'flex';
      hintEl.style.opacity = '1';
    }

    function hideHintWhileDragging() {
      if (hintEl) {
        hintEl.style.opacity = '0';
      }
    }

    function restoreHint() {
      if (hintEl) {
        hintEl.style.opacity = '1';
      }
    }

    // Pointer Drag Tracking
    let panStartX = 0;
    let panStartY = 0;

    cordBtn.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      cordBtn.setPointerCapture(e.pointerId);
      dragging = true;
      didDrag = true;
      clicked = false;
      panStartX = e.clientX;
      panStartY = e.clientY;
      hideHintWhileDragging();
      wake();
    });

    window.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const { stretchMax, stretchToggle } = CONFIG;
      const rx = e.clientX - panStartX;
      const ry = REST_Y + (e.clientY - panStartY);
      const dist = Math.hypot(rx, ry) || 1e-4;
      const maxD = REST_Y + stretchMax;
      const k = dist > maxD ? maxD / dist : 1;
      target = { x: ANCHOR_X + rx * k, y: ry * k };

      const clickAt = Math.min(stretchToggle, stretchMax - 1);
      if (!clicked && dist - REST_Y >= clickAt) {
        clicked = true;
        toggleTheme();
      }
    });

    function onPointerUp(e) {
      if (!dragging) return;
      dragging = false;
      try {
        cordBtn.releasePointerCapture(e.pointerId);
      } catch (_) {}

      const { maxVelocity } = CONFIG;
      const p = pts[last];
      const vx = p.x - p.ox;
      const vy = p.y - p.oy;
      const v = Math.hypot(vx, vy);
      if (v > maxVelocity) {
        const k = maxVelocity / v;
        p.ox = p.x - vx * k;
        p.oy = p.y - vy * k;
      }
      wake();
      requestAnimationFrame(() => {
        didDrag = false;
      });
      setTimeout(restoreHint, 600);
    }

    window.addEventListener('pointerup', onPointerUp);
    window.addEventListener('pointercancel', onPointerUp);

    // Click fallback (quick tap)
    cordBtn.addEventListener('click', (e) => {
      if (didDrag) return;
      toggleTheme();
      hideHintWhileDragging();
      setTimeout(restoreHint, 800);
      pts[last].oy -= 22;
      wake();
    });

    // Keyboard support (Space / Enter)
    cordBtn.addEventListener('keydown', (e) => {
      if ((e.key === 'Enter' || e.key === ' ') && !e.repeat) {
        e.preventDefault();
        toggleTheme();
        hideHintWhileDragging();
        setTimeout(restoreHint, 800);
        pts[last].oy -= 22;
        wake();
      }
    });

    // Drop entrance momentum transfer
    let dropDone = false;
    function endDrop() {
      if (dropDone) return;
      dropDone = true;
      innerEl.classList.remove('pullcord-inner--drop');
      // Impart entrance velocity to Verlet simulation
      pts[last].oy -= 13;
      pts[last].ox -= 6;
      wake();
    }

    innerEl.addEventListener('animationend', (e) => {
      if (e.animationName === 'pullcord-drop') {
        endDrop();
      }
    });

    // Fallback if animationend doesn't trigger
    setTimeout(endDrop, 1700);

    // Initial render
    render();
  })();
</script>
