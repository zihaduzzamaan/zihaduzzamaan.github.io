---
import { portfolioData } from '../data/portfolioData';

const { certifications } = portfolioData;
---

<section id="certifications" class="px-3.5 py-5 sm:px-6 sm:py-6">
  <!-- Section Header (Clean, Big & Bold: 1:1 with original design) -->
  <div class="mb-4 sm:mb-5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 border-b border-[var(--edge)] pb-2.5 sm:pb-3">
    <h2 class="text-xl sm:text-3xl font-bold tracking-tight text-[var(--foreground)]">
      Certifications & Achievements
    </h2>
    <span class="font-mono text-xs text-[var(--muted-foreground)]">Verified Track & Honors</span>
  </div>

  <!-- Minimal 2-Column Grid -->
  <div class="grid grid-cols-1 gap-2.5 sm:gap-3 sm:grid-cols-2">
    {certifications.map((cert) => (
      <div class="group flex items-center justify-between gap-3 rounded-xl border border-[var(--border)] bg-[var(--card)] p-3 sm:p-3.5 transition-all hover:border-[var(--muted-foreground)]/40 hover:bg-[var(--accent)]/20">
        <div class="flex items-center gap-3 min-w-0">
          <!-- Authentic Original Platform Logo -->
          <div class="flex size-9 sm:size-10 shrink-0 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--badge-bg)] overflow-hidden transition-transform duration-200 group-hover:scale-105">
            {/* 1. Official Udemy Logo */}
            {cert.platformKey === 'udemy' && (
              <svg class="size-4.5 sm:size-5 text-[#A435F0]" viewBox="0 0 24 24" fill="currentColor" aria-label="Udemy">
                <path d="M12 0L5.81 3.573v3.945l6.19-3.573 6.19 3.573V3.573L12 0zm-6.19 9.897v7.505c0 3.633 2.775 6.598 6.19 6.598s6.19-2.965 6.19-6.598V9.897L12 13.47 5.81 9.897z"/>
              </svg>
            )}

            {/* 2. Official Grameenphone Logo (Wikimedia) */}
            {cert.platformKey === 'gp' && (
              <svg class="size-4.5 sm:size-5" viewBox="0 0 51 48" fill="none" aria-label="Grameenphone Academy">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M25.221 14.4173C25.9354 14.5299 26.0799 14.3816 26.1746 13.6882C26.3296 12.6303 26.699 10.8466 27.5622 9.01821C28.4969 7.04658 29.9854 4.88017 32.0673 3.42958C33.8208 2.22364 36.6948 0.887949 38.9198 0.403463C40.7399 0.00162001 42.4453 -0.0750825 43.9085 0.0638832C46.9155 0.3412 48.5789 1.22057 49.4138 2.35871C49.7235 2.7839 49.8929 3.30843 49.8998 3.64801C49.9237 4.21411 49.6828 4.95287 48.89 5.67812C48.1186 6.37674 46.473 7.26061 44.2289 8.03459C41.8995 8.83009 38.7163 9.67013 35.5433 10.419C32.8864 11.0468 31.3747 11.581 30.1125 12.02C28.013 12.75 27.3802 14.8935 28.6885 15.5481C30.5794 16.494 31.7621 17.4831 32.77 18.324C34.2818 19.596 36.0375 21.0927 38.2173 23.792C40.1922 26.2673 43.4229 30.9916 44.5857 35.5772C45.8727 40.6117 45.0685 45.3861 42.2923 46.7193C39.5703 48.0286 35.943 46.1393 33.3967 43.4301C30.9742 40.8589 29.2834 37.8303 27.6936 33.1588C26.3148 29.1435 25.7559 23.3209 25.7582 20.275C25.7582 19.2603 25.7422 19.0438 25.7822 18.1275C25.8746 17.329 23.7764 16.6685 21.5213 18.1573C18.955 19.8514 16.4408 22.9217 14.9565 24.7048C14.3108 25.4831 13.4355 26.6269 12.5081 27.8264C11.2854 29.3999 9.93574 31.0385 8.70537 31.9546C6.85373 33.3395 3.8788 33.912 1.79502 32.3869C0.636703 31.5373 0.0201208 29.9332 0.000758975 28.3024C-0.0165069 27.1543 0.260945 26.1156 0.819642 25.091C1.51766 23.8332 2.6669 22.4833 4.4888 20.9374C6.37278 19.3488 9.38024 17.552 12.3941 16.3098C16.9912 14.411 21.9409 13.8136 25.221 14.4173" fill="#19AAF8"/>
              </svg>
            )}

            {/* 3. Official Programming Hero Logo (Official Web Asset) */}
            {cert.platformKey === 'programming-hero' && (
              <svg class="size-6 sm:size-7" viewBox="0 0 80 80" fill="none" aria-label="Programming Hero">
                <defs>
                  <linearGradient id="ph_grad_minimal" x1="4.5" y1="79.1" x2="70.9" y2="6.4" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#5C53FE" />
                    <stop offset="0.15" stop-color="#664CF9" />
                    <stop offset="0.41" stop-color="#8439EE" />
                    <stop offset="0.74" stop-color="#B31BDD" />
                    <stop offset="1" stop-color="#DC02CE" />
                  </linearGradient>
                </defs>
                <path d="M65.8197 0H13.5823C6.08098 0 0 6.12678 0 13.6845V66.3155C0 73.8732 6.08098 80 13.5823 80H65.8197C73.321 80 79.402 73.8732 79.402 66.3155V13.6845C79.402 6.12678 73.321 0 65.8197 0Z" fill="url(#ph_grad_minimal)"/>
                <path d="M27.605 23.402V61.6061H25.6574C22.8038 61.6061 20.4921 59.2343 20.4921 56.2995V28.7086C20.4921 25.7823 22.8038 23.402 25.6574 23.402H27.605Z" fill="white"/>
                <path d="M35.488 57.0758C33.8199 55.7108 33.3287 54.3287 33.3287 52.5456C33.3287 50.7625 34.0062 49.2866 35.6658 47.9215L48.0541 37.752C49.5529 38.7843 47.4529 47.4864 47.4529 47.4864L35.4795 57.0844L35.488 57.0758Z" fill="white"/>
                <path d="M27.605 66.1448V72.3473H25.6574C22.8038 72.3473 20.4921 69.9584 20.4921 67.0151V60.8127C20.4921 63.756 22.8038 66.1448 25.6574 66.1448H27.605Z" fill="white"/>
                <path d="M51.797 40.3285C50.112 43.3316 47.995 46.9831 47.9273 47.094C47.9696 47.0002 48.8926 44.7905 50.5353 40.2091C51.4414 37.6752 50.8571 37.0524 49.2228 35.8068C48.9434 35.5935 39.6458 28.2906 32.8378 22.9413V19.6311C40.0438 25.4837 50.1204 33.6739 50.4845 33.947C52.7793 35.6959 53.8547 36.6514 51.797 40.32V40.3285Z" fill="white"/>
                <path d="M56.3444 37.6325C54.346 40.1152 48.1899 46.8124 47.9444 47.094C47.9444 47.094 51.9411 41.3352 54.6847 37.5131C56.3613 35.1754 54.1851 33.964 52.5508 32.7184C52.2121 32.4624 39.1718 22.344 32.8549 17.4384V13.386C39.9508 19.1191 54.8202 31.1486 55.252 31.4813C57.5468 33.2303 58.6222 34.8171 56.3528 37.641L56.3444 37.6325Z" fill="white"/>
                <path d="M59.5707 37.7264C56.734 40.0128 48.207 46.8807 47.936 47.094C48.2578 46.7783 58.3259 37.5216 59.5961 35.3546C61.0526 32.8805 59.1134 32.4539 57.1151 30.6367C56.8272 30.3722 41.4582 17.8223 32.8296 10.7668V7.2518C42.4913 15.2117 60.011 29.6385 60.9933 30.3807C63.6098 32.36 63.0425 34.911 59.5538 37.7178L59.5707 37.7264Z" fill="white"/>
              </svg>
            )}

            {/* 4. Official YouTube Logo */}
            {cert.platformKey === 'youtube' && (
              <svg class="size-4.5 sm:size-5" viewBox="0 0 24 24" fill="none" aria-label="YouTube">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z" fill="#FF0000"/>
                <path d="M9.545 15.568V8.432L15.818 12l-6.273 3.568z" fill="white"/>
              </svg>
            )}

            {/* 5. Official Codeforces Logo */}
            {cert.platformKey === 'codeforces' && (
              <svg class="size-4.5 sm:size-5" viewBox="0 0 24 24" fill="none" aria-label="Codeforces">
                <path d="M4.5 7.5a1.5 1.5 0 0 1 3 0V18a1.5 1.5 0 0 1-3 0V7.5z" fill="#4B8BBE"/>
                <path d="M10.5 3a1.5 1.5 0 0 1 3 0V18a1.5 1.5 0 0 1-3 0V3z" fill="#E23E3E"/>
                <path d="M16.5 10.5a1.5 1.5 0 0 1 3 0V18a1.5 1.5 0 0 1-3 0v-7.5z" fill="#FFC107"/>
              </svg>
            )}

            {/* 6. Official freeCodeCamp Flame */}
            {cert.platformKey === 'freecodecamp' && (
              <svg class="size-4.5 sm:size-5 text-emerald-500" viewBox="0 0 24 24" fill="currentColor" aria-label="freeCodeCamp">
                <path d="M12 2c-.5 2-1 3.5-3 5.5-2 2-3 4-3 6.5 0 4.4 3.6 8 8 8s8-3.6 8-8c0-2.5-1-4.5-3-6.5-2-2-2.5-3.5-3-5.5-.3 1.5-.7 2.5-1.5 3.5-.8 1-1.5 1.5-1.5 3.5 0 1.1.9 2 2 2s2-.9 2-2c0-.5-.2-1-.5-1.5.8 1 1.5 2.2 1.5 3.5 0 2.8-2.2 5-5 5s-5-2.2-5-5c0-1.8.9-3.4 2.3-4.3-.2.8 0 1.7.5 2.3.6.7 1.4 1 2.2 1-.3-1-.2-2 .5-3 .7-1 1.5-2 1.5-3.5C12.7 3.5 12.3 2.7 12 2z"/>
              </svg>
            )}
          </div>

          <!-- Course & Platform Info -->
          <div class="space-y-0.5 min-w-0 pr-1">
            <h3 class="text-xs sm:text-[13px] font-semibold text-[var(--foreground)] leading-snug truncate group-hover:text-emerald-500 transition-colors">
              {cert.title}
            </h3>
            <div class="flex items-center gap-1.5 font-mono text-[10.5px] sm:text-[11px] text-[var(--muted-foreground)] truncate">
              <span class="font-medium text-[var(--foreground)]/80">{cert.platform}</span>
              <span>•</span>
              <span class="truncate">{cert.subtitle}</span>
              <span>•</span>
              <span class="shrink-0">{cert.date}</span>
            </div>
          </div>
        </div>

        <!-- Verified Shield (Original Icon from user screenshot) -->
        <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--badge-bg)] text-emerald-500 group-hover:border-emerald-500/30 transition-colors">
          <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>
      </div>
    ))}
  </div>
</section>
