---
import { portfolioData } from '../data/portfolioData';

const { education } = portfolioData;
---

<section id="education" class="px-3.5 py-6 sm:px-6 sm:py-8">
  <!-- Section Header (Clean, Big & Bold) -->
  <div class="mb-5 sm:mb-6 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 border-b border-[var(--edge)] pb-2.5 sm:pb-3">
    <h2 class="text-xl sm:text-3xl font-bold tracking-tight text-[var(--foreground)]">
      Education & Academic Honors
    </h2>
    <span class="font-mono text-xs text-[var(--muted-foreground)]">Software Engineering & Golden GPA 5.00</span>
  </div>

  <!-- Education Cards Grid -->
  <div class="space-y-3 sm:space-y-4">
    {education.map((item) => (
      <div class="rounded-xl border border-[var(--border)] bg-[var(--card)] p-3 sm:p-4 transition-all hover:border-[var(--muted-foreground)]/40">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-0.5 sm:gap-1 mb-1.5 sm:mb-2">
          <div class="flex items-center gap-2">
            <h3 class="text-xs sm:text-sm font-semibold text-[var(--foreground)]">
              {item.institution}
            </h3>
            {item.badge && (
              <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 font-mono text-[9.5px] sm:text-[10px] font-semibold text-amber-500">
                {item.badge}
              </span>
            )}
          </div>
          <span class="font-mono text-[11px] sm:text-xs text-[var(--muted-foreground)]">
            {item.period}
          </span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2 mb-2 text-[11px] sm:text-xs font-mono">
          <span class="text-[var(--foreground)] font-medium">{item.degree}</span>
          <span class="text-[var(--muted-foreground)]">•</span>
          <span class="text-emerald-500 font-semibold">{item.grade}</span>
        </div>

        <ul class="space-y-1 text-[11.5px] sm:text-xs text-[var(--muted-foreground)] leading-relaxed list-disc list-inside">
          {item.highlights.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
