---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SectionDivider from '../components/SectionDivider.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Reviews from '../components/Reviews.astro';
import TechStack from '../components/TechStack.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Certifications from '../components/Certifications.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="MD Zihaduzzaman | Full Stack Web Developer & Software Engineer"
  description="Portfolio of MD Zihaduzzaman. Full Stack Web Developer, Software Engineer, and aspiring Data Engineer. Software Engineering 2nd Year student with Golden GPA 5.00 in SSC & HSC."
>
  <main class="relative w-full">
    <!-- Sticky Top Navigation -->
    <Header />

    <!-- Hero & Identity Section with Overlapping Avatar & Live Matrix -->
    <Hero />

    <!-- Technical Hatched Spacer Bar -->
    <SectionDivider />

    <!-- 01. About & Philosophy -->
    <About />

    <!-- Technical Hatched Spacer Bar -->
    <SectionDivider />

    <!-- 02. Professional Experience & Milestones -->
    <Experience />

    <!-- Technical Hatched Spacer Bar -->
    <SectionDivider />

    <!-- 03. Selected Work / Proof of Work (2-Column Aarav Style) -->
    <Projects />

    <!-- Technical Hatched Spacer Bar -->
    <SectionDivider />

    <!-- 04. Reviews & Testimonials Carousel (Abdur Rehman Style) -->
    <Reviews />

    <!-- Technical Hatched Spacer Bar -->
    <SectionDivider />

    <!-- 05. Technical Stack (Categorized Abdul Style) -->
    <TechStack />

    <!-- Technical Hatched Spacer Bar -->
    <SectionDivider />

    <!-- 05. Education & Academic Honors (Golden GPA 5.00) -->
    <Education />

    <!-- Technical Hatched Spacer Bar -->
    <SectionDivider />

    <!-- 06. Certifications & Achievements -->
    <Certifications />

    <!-- Technical Hatched Spacer Bar -->
    <SectionDivider />

    <!-- 07. Social Links & Direct Connect -->
    <SocialLinks />

    <!-- Technical Blueprint Footer -->
    <Footer />
  </main>
</Layout>
