<style>
  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  /* Row 1: Smooth Leftward Infinite Scroll (45s) */
  .marquee-scroll-left {
    animation: scroll-to-left 45s linear infinite;
  }

  /* Row 2: Smooth Rightward Infinite Scroll (45s) */
  .marquee-scroll-right {
    animation: scroll-to-right 45s linear infinite;
  }

  /* Hover pause for interactive reading */
  .marquee-group:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes scroll-to-left {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes scroll-to-right {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-scroll-left,
    .marquee-scroll-right {
      animation: none;
    }
  }
</style>
